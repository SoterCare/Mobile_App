# ===========================================
# SoterCare Mobile App - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ===========================================
# Google OAuth Client IDs
# ===========================================
# Get these from Google Cloud Console:
# 1. Go to https://console.cloud.google.com/
# 2. Create/select a project
# 3. Enable "Google+ API" or "Google People API"
# 4. Go to Credentials -> Create Credentials -> OAuth 2.0 Client ID
# 5. Create THREE client IDs:
#    - Web application (for Expo Go proxy)
#    - Android (with package: com.sotercare.mobileapp)
#    - iOS (with bundle ID: com.sotercare.mobileapp)

# Web Client ID (REQUIRED for Expo Go development)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Android Client ID (for standalone Android builds)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# iOS Client ID (for standalone iOS builds)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# ===========================================
# Facebook OAuth
# ===========================================
# Get this from Facebook Developer Console:
# 1. Go to https://developers.facebook.com/
# 2. Create a new app or select existing
# 3. Add "Facebook Login" product
# 4. Configure OAuth redirect URIs:
#    - For Expo Go: https://auth.expo.io/@your-username/your-app-slug
#    - For standalone: sotercare://auth
# 5. Copy the App ID

EXPO_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id

# ===========================================
# Apple Sign In
# ===========================================
# Apple Sign-In works only on iOS devices (not Android/emulator)
# No client ID needed here - uses expo-apple-authentication
# Requirements:
# 1. Apple Developer account
# 2. Enable "Sign in with Apple" capability in your app
# 3. Configure in Apple Developer portal under Identifiers
# Note: Apple only returns user's name/email on FIRST sign-in

# ===========================================
# Backend API Configuration
# ===========================================
# EXPO_PUBLIC_API_URL=https://api.sotercare.com
